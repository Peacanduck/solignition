{
  "compilerOptions": {
    /* Self-contained: the repo root has no tsconfig.json since the npm-workspaces
       restructure (the old root config was deleted in 30d0fc6). anchor builds
       standalone, so we set every option here instead of extending the root. */
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["mocha", "chai", "node"],
    /* optional: if you want to use @project/anchor imports inside tests */
    "baseUrl": ".",
    "paths": {
      "@coral-xyz/anchor": ["../node_modules/@coral-xyz/anchor"],
      
    }
  },
  "include": ["tests/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}