{
  "name": "solignition",
  "workspaces": [
    "anchor/*",
    "deploy/*",
    "src/*",
    "landing/*",
    "docs/*"
  ],
  "scripts": {
    "anchor": "cd anchor && anchor",
    "anchor-build": "cd anchor && anchor build",
    "anchor-localnet": "cd anchor && anchor localnet",
    "anchor-test": "cd anchor && anchor test",
    "build": "tsc -b && vite build",
    "codama:js": "codama run js -c ./anchor/codama.js",
    "ci": "npm run build && npm run lint && npm run format:check && npm run codama:js",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup": "npm run anchor keys sync && npm run anchor build && npm run codama:js"
  },
  "description": "React+Vite, Tailwind, gill (based on @solana/kit), Anchor Solignition example, Wallet UI",
  "keywords": [
    "anchor-solignition",
    "gill",
    "react",
    "solana-kit",
    "tailwind",
    "typescript",
    "vite",
    "wallet-ui"
  ],
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@codama/renderers-rust": "^1.2.7",
    "@coral-xyz/anchor": "^0.32.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@solana-mobile/wallet-standard-mobile": "^0.5.2",
    "@solana/webcrypto-ed25519-polyfill": "^2.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "@wallet-ui/react": "2.0.0",
    "@wallet-ui/react-gill": "2.0.0",
    "@wallet-ui/tailwind": "2.0.0",
    "bs58": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gill": "0.14.0",
    "jotai": "^2.20.0",
    "lucide-react": "^0.544.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.2",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "react-router": "^7.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.3.8",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@codama/cli": "^1.5.1",
    "@codama/nodes-from-anchor": "^1.4.1",
    "@codama/renderers-js": "^1.3.4",
    "@eslint/js": "^9.35.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.3",
    "chai": "^6.2.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.4.0",
    "prettier": "^3.8.3",
    "ts-mocha": "^11.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.1.6",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
