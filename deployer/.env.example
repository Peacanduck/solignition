# ============ Required ============

# Solana RPC. For mainnet, use your own provider — public endpoints rate-limit.
RPC_URL=https://api.devnet.solana.com

# Solignition program ID (must match the on-chain deployment).
PROGRAM_ID=HVzpjSxwECnb6uY9Jnia48oJp4xrQiz5jgc5hZC5df63

# Deployer keypair — encrypted with `age` is strongly preferred.
# Use scripts/encrypt-keypair.ts to convert a plaintext .json into a .age file.
DEPLOYER_KEYPAIR_PATH=./keys/deployer-keypair.age
DEPLOYER_KEYPAIR_PASSPHRASE=change-me-set-via-azure-application-settings

# Admin keypair — same encryption story. Optional unless used.
# ADMIN_KEYPAIR_PATH=./keys/admin-keypair.age
# ADMIN_KEYPAIR_PASSPHRASE=

# ============ Server ============

PORT=3000
NODE_ENV=production

# ============ Auth ============

# Wallet-signature auth enforcement mode for inbound requests:
#   off      — no auth check (legacy behavior, not for production)
#   warn     — verify signatures, log failures, but allow anonymous requests through
#   enforce  — verify signatures, reject failures with 401
#
# Rollout sequence: deploy with `warn`, watch metrics confirm all real traffic
# is signed, then flip to `enforce` and redeploy.
REQUIRE_AUTH=enforce

# Additional CORS origins (comma-separated). Defaults already include
# https://app.solignition.xyz and https://www.solignition.xyz, plus localhost
# variants when NODE_ENV=development. CLI/curl/server callers bypass CORS.
# EXTRA_FRONTEND_ORIGINS=https://staging.solignition.xyz

# ============ Uploads ============

# Maximum upload size in bytes (default 4 MB).
MAX_UPLOAD_BYTES=10485760

# ============ Optional ============

# WS_URL=
# CLUSTER=devnet
# BINARY_STORAGE_PATH=./binaries
# UPLOAD_PATH=./uploads
# DB_PATH=./deployer-state
# IDL_PATH=./idl.json
# MAX_RETRIES=3
# RETRY_DELAY_MS=5000
# POLL_INTERVAL_MS=5000
# GRAPHQL_ENDPOINT=
# SOLANA_CLI_PATH=solana
