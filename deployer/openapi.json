{
  "openapi": "3.1.0",
  "info": {
    "title": "Solignition Deployer API",
    "version": "1.0.0",
    "description": "Off-chain deployer service for the Solignition Solana lending protocol. Authenticated with the solignition-auth-v1 wallet-signature scheme — see deployer/src/auth.ts."
  },
  "servers": [
    {
      "url": "https://api.solignition.ngrok.app"
    }
  ],
  "components": {
    "securitySchemes": {
      "solignitionAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Auth-Pubkey",
        "description": "solignition-auth-v1: send X-Auth-Pubkey, X-Auth-Timestamp, X-Auth-Nonce, X-Auth-Signature. See deployer/src/auth.ts for the canonical message format."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "JobAcceptedResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string"
          },
          "jobId": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "message",
          "jobId"
        ]
      },
      "DeploymentRecord": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "loanId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^\\d+$",
            "description": "On-chain loan id (u64 as string)",
            "example": "42"
          },
          "borrower": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana base58 pubkey",
            "example": "11111111111111111111111111111111"
          },
          "programId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana base58 pubkey",
            "example": "11111111111111111111111111111111"
          },
          "deploymentCost": {
            "type": "number"
          },
          "deployTxSignature": {
            "type": "string",
            "minLength": 80,
            "maxLength": 95,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana transaction signature (base58)",
            "example": "5j7s..."
          },
          "setDeployedTxSignature": {
            "type": "string",
            "minLength": 80,
            "maxLength": 95,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana transaction signature (base58)",
            "example": "5j7s..."
          },
          "recoveryTxSignature": {
            "type": "string",
            "minLength": 80,
            "maxLength": 95,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana transaction signature (base58)",
            "example": "5j7s..."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "deploying",
              "deployed",
              "recovering",
              "recovered",
              "failed"
            ]
          },
          "error": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "integer"
          },
          "binaryHash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "binaryPath": {
            "type": "string"
          },
          "principal": {
            "type": "string"
          },
          "programAccountOpen": {
            "type": "boolean"
          }
        },
        "required": [
          "loanId",
          "borrower",
          "status",
          "createdAt",
          "updatedAt",
          "principal",
          "programAccountOpen"
        ]
      },
      "LoanStatusResponse": {
        "type": "object",
        "properties": {
          "loanId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^\\d+$",
            "description": "On-chain loan id (u64 as string)",
            "example": "42"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "uploading",
              "deploying",
              "deployed",
              "failed",
              "repaid",
              "expired"
            ]
          },
          "deployment": {
            "$ref": "#/components/schemas/DeploymentRecord"
          },
          "updatedAt": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "loanId",
          "status",
          "deployment",
          "updatedAt"
        ]
      },
      "CreateLoanResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string"
          },
          "signature": {
            "type": "string",
            "minLength": 80,
            "maxLength": 95,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana transaction signature (base58)",
            "example": "5j7s..."
          },
          "fileId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "pattern": "^[a-f0-9]{16}$",
            "example": "0a1b2c3d4e5f6789"
          }
        },
        "required": [
          "success",
          "message",
          "signature",
          "fileId"
        ]
      },
      "CreateLoanBody": {
        "type": "object",
        "properties": {
          "signature": {
            "type": "string",
            "minLength": 80,
            "maxLength": 95,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana transaction signature (base58)",
            "example": "5j7s..."
          },
          "borrower": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana base58 pubkey",
            "example": "11111111111111111111111111111111"
          },
          "loanId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^\\d+$",
            "description": "On-chain loan id (u64 as string)",
            "example": "42"
          },
          "fileId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "pattern": "^[a-f0-9]{16}$",
            "example": "0a1b2c3d4e5f6789"
          }
        },
        "required": [
          "signature",
          "borrower",
          "loanId",
          "fileId"
        ]
      },
      "CreateRepaymentResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string"
          },
          "loanId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^\\d+$",
            "description": "On-chain loan id (u64 as string)",
            "example": "42"
          },
          "auth": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana base58 pubkey",
            "example": "11111111111111111111111111111111"
          },
          "tx": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "message",
          "loanId",
          "auth"
        ]
      },
      "CreateRepaymentBody": {
        "type": "object",
        "properties": {
          "signature": {
            "type": "string",
            "minLength": 80,
            "maxLength": 95,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana transaction signature (base58)",
            "example": "5j7s..."
          },
          "borrower": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana base58 pubkey",
            "example": "11111111111111111111111111111111"
          }
        },
        "required": [
          "signature",
          "borrower"
        ]
      },
      "CreateUploadResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "fileId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "pattern": "^[a-f0-9]{16}$",
            "example": "0a1b2c3d4e5f6789"
          },
          "estimatedCost": {
            "type": "number"
          },
          "binaryHash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "fileId",
          "estimatedCost",
          "binaryHash",
          "message"
        ]
      },
      "CreateUploadFormFields": {
        "type": "object",
        "properties": {
          "borrower": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana base58 pubkey",
            "example": "11111111111111111111111111111111"
          },
          "expectedHash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$",
            "description": "sha256(file) computed by the client. If provided, the server rejects with 422 when the computed hash does not match."
          }
        },
        "required": [
          "borrower"
        ]
      },
      "FileUploadRecord": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "pattern": "^[a-f0-9]{16}$",
            "example": "0a1b2c3d4e5f6789"
          },
          "borrower": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana base58 pubkey",
            "example": "11111111111111111111111111111111"
          },
          "fileName": {
            "type": "string"
          },
          "filePath": {
            "type": "string"
          },
          "fileSize": {
            "type": "integer",
            "minimum": 0
          },
          "binaryHash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "estimatedCost": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "deployed"
            ]
          },
          "createdAt": {
            "type": "integer"
          }
        },
        "required": [
          "fileId",
          "borrower",
          "fileName",
          "filePath",
          "fileSize",
          "binaryHash",
          "estimatedCost",
          "status",
          "createdAt"
        ]
      },
      "PaginatedUploads": {
        "type": "object",
        "properties": {
          "uploads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileUploadRecord"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "uploads",
          "total",
          "limit",
          "offset",
          "hasMore"
        ]
      },
      "PaginatedDeployments": {
        "type": "object",
        "properties": {
          "deployments": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/DeploymentRecord"
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "deployments",
          "total",
          "limit",
          "offset",
          "hasMore"
        ]
      },
      "ProjectProgramRef": {
        "type": "object",
        "properties": {
          "loanId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^\\d+$",
            "description": "On-chain loan id (u64 as string)",
            "example": "42"
          },
          "fileId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "pattern": "^[a-f0-9]{16}$",
            "example": "0a1b2c3d4e5f6789"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "loanId",
          "fileId",
          "index"
        ]
      },
      "CreateProjectResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "description": "Client-generated project id (UUID v4)",
            "example": "3f2504e0-4f89-41d3-9a0c-0305e82c3301"
          },
          "signature": {
            "type": "string",
            "minLength": 80,
            "maxLength": 95,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana transaction signature (base58)",
            "example": "5j7s..."
          },
          "programs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectProgramRef"
            }
          }
        },
        "required": [
          "success",
          "message",
          "projectId",
          "signature",
          "programs"
        ]
      },
      "CreateProjectProgram": {
        "type": "object",
        "properties": {
          "loanId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^\\d+$",
            "description": "On-chain loan id (u64 as string)",
            "example": "42"
          },
          "fileId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "pattern": "^[a-f0-9]{16}$",
            "example": "0a1b2c3d4e5f6789"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "loanId",
          "fileId"
        ]
      },
      "CreateProjectBody": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid",
            "description": "Client-generated project id (UUID v4)",
            "example": "3f2504e0-4f89-41d3-9a0c-0305e82c3301"
          },
          "borrower": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana base58 pubkey",
            "example": "11111111111111111111111111111111"
          },
          "signature": {
            "type": "string",
            "minLength": 80,
            "maxLength": 95,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana transaction signature (base58)",
            "example": "5j7s..."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "programs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateProjectProgram"
            },
            "minItems": 2,
            "maxItems": 4
          }
        },
        "required": [
          "projectId",
          "borrower",
          "signature",
          "programs"
        ]
      },
      "ProjectRecord": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid",
            "description": "Client-generated project id (UUID v4)",
            "example": "3f2504e0-4f89-41d3-9a0c-0305e82c3301"
          },
          "borrower": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana base58 pubkey",
            "example": "11111111111111111111111111111111"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "signature": {
            "type": "string",
            "minLength": 80,
            "maxLength": 95,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana transaction signature (base58)",
            "example": "5j7s..."
          },
          "programs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectProgramRef"
            },
            "minItems": 2,
            "maxItems": 4
          },
          "createdAt": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "integer"
          }
        },
        "required": [
          "projectId",
          "borrower",
          "signature",
          "programs",
          "createdAt",
          "updatedAt"
        ]
      },
      "ProjectStatus": {
        "type": "string",
        "enum": [
          "pending",
          "deploying",
          "partial",
          "deployed",
          "failed"
        ]
      },
      "ProjectProgramStatus": {
        "type": "object",
        "properties": {
          "loanId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^\\d+$",
            "description": "On-chain loan id (u64 as string)",
            "example": "42"
          },
          "fileId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "pattern": "^[a-f0-9]{16}$",
            "example": "0a1b2c3d4e5f6789"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "uploading",
              "deploying",
              "deployed",
              "failed",
              "repaid",
              "expired"
            ]
          },
          "deployment": {
            "$ref": "#/components/schemas/DeploymentRecord"
          }
        },
        "required": [
          "loanId",
          "fileId",
          "index",
          "status",
          "deployment"
        ]
      },
      "ProjectAggregateResponse": {
        "type": "object",
        "properties": {
          "project": {
            "$ref": "#/components/schemas/ProjectRecord"
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus"
          },
          "programs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectProgramStatus"
            }
          }
        },
        "required": [
          "project",
          "status",
          "programs"
        ]
      },
      "ProjectSummary": {
        "type": "object",
        "properties": {
          "project": {
            "$ref": "#/components/schemas/ProjectRecord"
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus"
          }
        },
        "required": [
          "project",
          "status"
        ]
      },
      "PaginatedProjects": {
        "type": "object",
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSummary"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "projects",
          "total",
          "limit",
          "offset",
          "hasMore"
        ]
      },
      "ProjectRepaymentResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "message": {
            "type": "string"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "description": "Client-generated project id (UUID v4)",
            "example": "3f2504e0-4f89-41d3-9a0c-0305e82c3301"
          },
          "programs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "loanId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20,
                  "pattern": "^\\d+$",
                  "description": "On-chain loan id (u64 as string)",
                  "example": "42"
                },
                "auth": {
                  "type": "string",
                  "minLength": 32,
                  "maxLength": 44,
                  "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
                  "description": "Solana base58 pubkey",
                  "example": "11111111111111111111111111111111"
                }
              },
              "required": [
                "loanId",
                "auth"
              ]
            }
          }
        },
        "required": [
          "success",
          "message",
          "projectId",
          "programs"
        ]
      },
      "CreateProjectRepaymentBody": {
        "type": "object",
        "properties": {
          "signature": {
            "type": "string",
            "minLength": 80,
            "maxLength": 95,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana transaction signature (base58)",
            "example": "5j7s..."
          },
          "borrower": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
            "description": "Solana base58 pubkey",
            "example": "11111111111111111111111111111111"
          }
        },
        "required": [
          "signature",
          "borrower"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus metrics",
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "Prometheus text format"
          }
