{
  "name": "solana-lending-deployer",
  "version": "1.0.0",
  "description": "Off-chain deployer service for Solana lending protocol",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "check-idl": "node check-idl.js",
    "openapi:gen": "ts-node scripts/generate-openapi.ts",
    "openapi:check": "ts-node scripts/generate-openapi.ts - > /tmp/openapi-new.json && diff -u openapi.json /tmp/openapi-new.json"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.95.0",
    "age-encryption": "^0.2.3",
    "bs58": "^5.0.0",
    "cors": "2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "graphql-request": "7.3.0",
    "helmet": "^8.0.0",
    "level": "^8.0.0",
    "lru-cache": "^11.0.2",
    "multer": "2.0.2",
    "prom-client": "^15.1.0",
    "swagger-ui-express": "^5.0.1",
    "tweetnacl": "^1.0.3",
    "uuid": "^11.0.3",
    "winston": "^3.11.0",
    "zod": "~3.24.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.9.1",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
